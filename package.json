{
  "name": "agent-dev-crew",
  "private": true,
  "description": "A team of AI agents that takes a feature request to a tested diff, with a human gate, a cost trace and a playbook that learns.",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm -r --if-present run dev",
    "build": "pnpm -r --if-present run build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "e2e": "playwright test --pass-with-no-tests",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "qa": "pnpm check && pnpm e2e",
    "crew": "pnpm -s --filter @crew/api... build && node packages/api/dist/cli.js",
    "demo": "pnpm build && node packages/api/dist/cli.js serve",
    "eval": "pnpm --filter \"@crew/evals...\" build && node evals/dist/eval-cli.js",
    "share-images": "pnpm build && node apps/web/scripts/share-images.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@crew/api": "workspace:*",
    "@crew/core": "workspace:*",
    "@crew/engine": "workspace:*",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "^22.20.7",
    "@vitest/coverage-v8": "5.1.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
