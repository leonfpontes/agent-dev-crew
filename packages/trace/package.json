{
  "name": "@crew/trace",
  "version": "0.1.0",
  "private": true,
  "description": "The trace database: runs, steps, events, costs, lessons and playbook versions in SQLite, with migrations and the replay seed.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "crew-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "seed": "pnpm run build && node dist/seed-cli.js"
  },
  "dependencies": {
    "@crew/core": "workspace:*"
  },
  "devDependencies": {
    "@crew/evals": "workspace:*"
  }
}
